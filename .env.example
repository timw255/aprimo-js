# =============================================================================
# Aprimo SDK integration test configuration
# =============================================================================
# Copy this file to .env and supply your tenant's IDs. Pattern: one env var
# per parent the suite operates against; tests CRUD their own children.
# Tests pass or fail — they do not skip.

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
APRIMO_ENVIRONMENT=
APRIMO_CLIENT_ID=
APRIMO_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# DAM
# -----------------------------------------------------------------------------
TEST_RECORD_ID=
TEST_PUBLIC_LINK_PROVIDER=
APRIMO_DAM_TEST_USER_GROUP_ID=
APRIMO_DAM_FILE_VERSION_ID=
APRIMO_DAM_ADDITIONAL_FILE_ID=
APRIMO_DAM_TEST_CHECK_ACTION_TYPE_ID=
APRIMO_DAM_TEST_CHECK_CATEGORY_ID=

# -----------------------------------------------------------------------------
# PM anchors (tests CRUD their own children against these)
# -----------------------------------------------------------------------------
APRIMO_PM_ACTIVITY_ID=
APRIMO_PM_PROJECT_ID=
APRIMO_PM_DIGITAL_ASSET_ID=
APRIMO_PM_SUPPLIER_ID=
APRIMO_PM_USER_ROLE_ID=
APRIMO_PM_ATTACHMENT_ID=
APRIMO_PM_GROUP_ID=
APRIMO_PM_OFFER_ID=
APRIMO_PM_ACTIVITY_CELL_ID=
APRIMO_PM_ACTIVITY_TREATMENT_ID=

# -----------------------------------------------------------------------------
# PM resources with no SDK create endpoint
# -----------------------------------------------------------------------------
APRIMO_PM_PROGRAM_ID=
APRIMO_PM_PROGRAM_PROPOSAL_ID=
APRIMO_PM_TEAM_ID=
APRIMO_PM_TREATMENT_ID=
APRIMO_PM_LOOKUP_ID=
APRIMO_PM_CONTENT_PLAN_ID=
APRIMO_PM_DIGITAL_ASSET_FOLDER_ID=
APRIMO_PM_TASK_ID=
APRIMO_PM_TASK_DOCUMENT_ID=
APRIMO_PM_TASK_DOCUMENT_VERSION_ID=
APRIMO_PM_EXTENDED_ATTRIBUTE_ID=
APRIMO_PM_EXTENDED_ATTRIBUTE_CHILD_ID=
APRIMO_PM_EXTENDED_ATTRIBUTE_PARENT_ITEM_ID=
APRIMO_PM_FINANCE_GROUP_ID=
APRIMO_PM_FISCAL_YEAR_ID=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
APRIMO_PM_TEST_VERBOSE=
